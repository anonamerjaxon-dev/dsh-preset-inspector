#!/usr/bin/env node
// dsh-presets — answer "what is actually inside preset X?" from the composed
// profile tree, not from documentation.
//
// ── How DSH composes, verified against the 0.2.1-rc.2 sources ──────────────
//
// A PROFILE is one server process: `$DSH_HOME/profiles/<name>/`, a list of
// bundles (`package.json` → `dsh.profile.bundles`) whose patch files are applied
// in order, then the profile's own `cordis.patch.yml`, then any `--patch`
// overlay. The result is one Loader entry tree, which we call the HOST layer.
//
// A PRESET is one row in that tree: `name: '@deepseek-ai/dsh-agent-preset'`
// with `config.plugins` — a COMPLETE child plugin list. A preset never inherits
// another preset, and it does not inherit bundle rows selectively: the rows it
// declares are the rows it mounts. `dsh --dump-config` prints that composed tree
// in full, so the dump is the ground truth for preset membership and needs no
// running server.
//
// Two things leak into every preset anyway, and both are why a naive "count the
// preset's rows" answer is wrong:
//
//   1. HOST TOOLS. The tool registry builds a scope's visible set from the
//      global layer plus the scope's ancestor layers (`ToolRuntime.view`).
//      A host row that registers tools is therefore visible inside every
//      preset. The shipped composition declares most tool plugins at host
//      level as `disabled: true` and re-mounts them per preset, so only a few
//      stay enabled — image-gen's six tools, working-directory, and a couple
//      of gated ones.
//   2. CONDITIONAL ROWS. A row gated by `!!js` (e.g. pwsh on macOS) or by a
//      config flag (list_subagent_models) may register no tools at all.
//      Those are reported as conditional, not counted as present.
//
// Skills are filesystem discovery, not rows: a preset's skills are the roots its
// `skill-filesystem` rows scan (`customSkillDirs` plus the default project and
// user roots, or only the custom ones when `includeDefaultRoots: false`), plus
// skills a plugin registers at runtime.
//
// MCP servers are processes: one `dsh-mcp-client` row with `serverName: x` starts
// one server at boot and publishes `mcp__x__*` tools. Two rows with the same
// name fail; two rows with different ids but the same `serverName` start it
// twice — that is the duplicate-MCP trap.
//
// ── Subcommands ────────────────────────────────────────────────────────────
//
//   dsh-presets list               presets with tool / skill / MCP counts
//   dsh-presets show <preset>      everything in one preset
//   dsh-presets matrix             capability × preset grid
//   dsh-presets diff <a> <b>       differences between two presets
//   dsh-presets json               machine-readable snapshot
//
// Flags: --profile <name> (default: web)   --refresh (re-compose, ignore cache)

import fs from 'node:fs'
import path from 'node:path'
import os from 'node:os'
import { createRequire } from 'node:module'

const require = createRequire(import.meta.url)
const { execFileSync } = require('node:child_process')

const DSH_HOME = process.env.DSH_HOME ?? path.join(os.homedir(), '.dsh')

// The DSH install that owns this CLI. It carries js-yaml, every first-party
// plugin package, and the bundle patch files (the shipped presets live there).
function findDshRoot() {
  if (process.env.DSH_ROOT) return process.env.DSH_ROOT
  try {
    const bin = execFileSync('which', ['dsh'], { encoding: 'utf8' }).trim()
    // .../lib/node_modules/@deepseek-ai/dsh/lib/bin.js → the package root
    return path.dirname(path.dirname(fs.realpathSync(bin)))
  } catch {
    const prefix = path.resolve(path.dirname(process.execPath), '..')
    const fromExe = path.join(prefix, 'lib', 'node_modules', '@deepseek-ai', 'dsh')
    if (fs.existsSync(fromExe)) return fromExe
    const home = path.join(os.homedir(), '.nvm', 'versions', 'node')
    if (fs.existsSync(home)) {
      for (const v of fs.readdirSync(home)) {
        const p = path.join(home, v, 'lib', 'node_modules', '@deepseek-ai', 'dsh')
        if (fs.existsSync(p)) return p
      }
    }
    throw new Error('cannot locate the dsh install; set DSH_ROOT')
  }
}

const DSH_ROOT = findDshRoot()
const DSH_PKG_DIR = path.join(DSH_ROOT, 'node_modules', '@deepseek-ai')
const yaml = (await import(path.join(DSH_ROOT, 'node_modules', 'js-yaml', 'index.js'))).default

const CACHE_DIR = path.join(DSH_HOME, 'cache')

const USAGE = `dsh-presets — inspect what each agent preset actually composes

usage: dsh-presets [--profile <name>] [--refresh] <command>

commands:
  list                 presets with tool / skill / MCP counts
  show <preset>        full breakdown of one preset
  matrix               capability-by-preset grid
  diff <a> <b>         differences between two presets
  json                 machine-readable snapshot

flags:
  --profile <name>     profile to inspect (default: web)
  --refresh            re-compose the profile instead of using the cache
`

// ─────────────────────────────────────────────────────────── composed tree

function dumpProfile(profile, refresh) {
  fs.mkdirSync(CACHE_DIR, { recursive: true })
  const cacheFile = path.join(CACHE_DIR, `composed-${profile}.yml`)
  const stampFile = path.join(CACHE_DIR, `composed-${profile}.stamp`)
  const watched = [
    path.join(DSH_HOME, 'profiles', profile, 'cordis.patch.yml'),
    path.join(DSH_HOME, 'profiles', profile, 'package.json'),
  ]
  const newest = Math.max(0, ...watched.map((f) => (fs.existsSync(f) ? fs.statSync(f).mtimeMs : 0)))
  const cached = fs.existsSync(cacheFile) && fs.existsSync(stampFile)
    ? Number(fs.readFileSync(stampFile, 'utf8'))
    : 0
  if (!refresh && cached >= newest && newest > 0) {
    return { yml: fs.readFileSync(cacheFile, 'utf8'), fromCache: true }
  }
  const out = execFileSync('dsh', ['--profile', profile, '--dump-config'], {
    encoding: 'utf8',
    maxBuffer: 64 * 1024 * 1024,
    stdio: ['ignore', 'pipe', 'inherit'],
  })
  fs.writeFileSync(cacheFile, out)
  fs.writeFileSync(stampFile, String(Date.now()))
  return { yml: out, fromCache: false }
}

// `!!js` gates are kept as data so a row can still be reported.
const SCHEMA = yaml.DEFAULT_SCHEMA.extend([
  new yaml.Type('tag:yaml.org,2002:js', {
    kind: 'scalar',
    construct: (d) => ({ __js: String(d) }),
  }),
])

// ─────────────────────────────────────────────────────── module resolution

const pkgCache = new Map()

function splitModule(moduleName) {
  if (!moduleName) return { pkg: null, sub: null }
  const parts = moduleName.split('/')
  const pkg = moduleName.startsWith('@') ? parts.slice(0, 2).join('/') : parts[0]
  return { pkg, sub: moduleName === pkg ? null : moduleName.slice(pkg.length + 1) }
}

function packageDir(profile, moduleName) {
  if (!moduleName) return null
  if (pkgCache.has(moduleName)) return pkgCache.get(moduleName)
  const { pkg } = splitModule(moduleName)
  const roots = [
    path.join(DSH_HOME, 'profiles', profile, 'node_modules'),
    path.join(DSH_ROOT, 'node_modules'),
    DSH_PKG_DIR,
  ]
  let found = null
  for (const root of roots) {
    const dir = path.join(root, pkg)
    if (fs.existsSync(path.join(dir, 'package.json'))) { found = dir; break }
  }
  pkgCache.set(moduleName, found)
  return found
}

// ────────────────────────────────────────────── tools a module registers
//
// Static, so it also describes a preset that is not currently mounted. Three
// patterns cover the shipped code: a literal inside `defineTool({...})`, a
// literal bound to a constant the same file then passes to `defineTool`, and a
// per-row `toolName:` override. Anything a plugin composes at runtime from data
// this reader cannot see is reported as conditional instead of guessed.

// `run_code` is not registered by a plugin: the registry adds it to a scope
// whose presentation mode is not native (PTC). It is in dsh-tools' source but
// belongs to a mode, not a package, so it is never attributed to one.
const MODE_PROVIDED_TOOLS = new Set(['run_code'])

const toolCache = new Map()

function toolsOf(dir, moduleName) {
  if (!dir) return { names: [], approx: false }
  const key = dir + '::' + (moduleName ?? '')
  if (toolCache.has(key)) return toolCache.get(key)

  const files = []
  const walk = (p, depth) => {
    if (depth > 3 || !fs.existsSync(p)) return
    for (const e of fs.readdirSync(p, { withFileTypes: true })) {
      const q = path.join(p, e.name)
      if (e.isDirectory()) walk(q, depth + 1)
      else if (e.name.endsWith('.js') || e.name.endsWith('.mjs')) files.push(q)
    }
  }
  for (const d of ['lib', 'dist']) walk(path.join(dir, d), 0)

  // A subpath export (`pkg/tools`, `pkg/list-agents`) mounts one file, not the
  // whole package; narrow when that file exists.
  const { sub } = splitModule(moduleName)
  let scan = files
  let approx = false
  if (sub) {
    const leaf = sub.split('/').pop()
    const narrowed = files.filter((f) => path.basename(f).replace(/\.m?js$/, '').includes(leaf))
    if (narrowed.length) scan = narrowed
    else approx = true
  }

  const names = new Set()
  for (const f of scan) {
    let s
    try { s = fs.readFileSync(f, 'utf8') } catch { continue }
    for (const m of s.matchAll(/toolName:\s*["'`]([a-zA-Z0-9_]+)["'`]/g)) names.add(m[1])
    for (const m of s.matchAll(/defineTool\(\{\s*name:\s*["'`]([a-zA-Z0-9_]+)["'`]/g)) names.add(m[1])
    // const NAME = "tool_name" … defineTool({ name: NAME
    const consts = new Map()
    for (const m of s.matchAll(/\bconst\s+([A-Za-z_$][\w$]*)\s*=\s*["'`]([a-z][a-z0-9_]{2,40})["'`]/g)) {
      consts.set(m[1], m[2])
    }
    if (consts.size) {
      for (const m of s.matchAll(/defineTool\(\{[\s\S]{0,600}?\bname:\s*([A-Za-z_$][\w$]*)/g)) {
        const hit = consts.get(m[1])
        if (hit) names.add(hit)
      }
    }
  }
  const result = {
    names: [...names].filter((n) => n.length > 1 && !MODE_PROVIDED_TOOLS.has(n)).sort(),
    approx,
  }
  toolCache.set(key, result)
  return result
}

// Tools a package registers only under a condition this reader cannot evaluate.
// Each entry names the reason; delete an entry when the plugin starts
// registering eagerly and the inventory picks it up again.
const CONDITIONAL_TOOLS = new Map([
  ['list_subagent_models', 'registered only when subagent model selection is enabled'],
])

// Host-level rows whose tools do not exist at session start.
const DEFERRED_PACKAGES = new Map([
  ['@anionex/dsh-computer-use', 'tools appear only after the computer-use skill activates them'],
  ['@deepseek-ai/dsh-mcp-resources', 'tools appear only once an MCP server publishes resources'],
  ['@deepseek-ai/dsh-plugin-manager', 'gated on !!js ctx.get("profileContext")'],
])

// ──────────────────────────────────────────────────────── composition model

// The Loader evaluates a `!!js` `disabled` node against its own context and
// treats a throw as "leave the decision to the mount" (the registry's
// `disabledContribution`). Mirror that: evaluate what can be evaluated, and
// fall back to 'conditional' when the expression needs a live context.
// Returns true when the row is disabled, false when it is enabled, and
// 'conditional' when the expression needs a live Loader context.
function evalDisabled(value) {
  if (value === undefined) return false
  if (typeof value !== 'object' || value === null || !('__js' in value)) return Boolean(value)
  try {
    const fn = new Function('process', 'ctx', `return (${value.__js})`)
    const ctx = { get: () => undefined, has: () => false }
    return Boolean(fn(process, ctx))
  } catch {
    return 'conditional'
  }
}

function flatten(rows, out = [], depth = 0) {
  for (const row of rows ?? []) {
    if (!row || typeof row !== 'object') continue
    const decision = evalDisabled(row.disabled)
    const conditional = decision === 'conditional'
    const enabled = conditional ? 'conditional' : !decision
    if (row.group === true) {
      for (const child of row.config ?? []) flatten([child], out, depth + 1)
      continue
    }
    out.push({
      id: row.id ?? null,
      module: row.name,
      enabled,
      condition: typeof row.disabled === 'object' && row.disabled !== null ? row.disabled.__js : undefined,
      depth,
      config: row.config,
    })
  }
  return out
}

function skillRootsFrom(config) {
  const c = config ?? {}
  const custom = (c.customSkillDirs ?? []).map((d) => ({
    dir: typeof d === 'string' ? d : d?.__js ? `!!js ${String(d.__js).slice(0, 60)}` : String(d),
    source: 'custom',
  }))
  if (c.includeDefaultRoots === false) {
    return [...custom, ...(c.bundledSkillDir ? [{ dir: c.bundledSkillDir, source: 'bundled' }] : [])]
  }
  return [
    { dir: '«project»/.dsh/skills', source: 'project-dsh' },
    { dir: '«project»/.agents/skills', source: 'project-agents' },
    ...custom,
    { dir: path.join(DSH_HOME, 'skills'), source: 'user-dsh' },
    { dir: path.join(os.homedir(), '.agents', 'skills'), source: 'user-agents' },
    ...(c.bundledSkillDir ? [{ dir: c.bundledSkillDir, source: 'bundled' }] : []),
  ]
}

// <name>/SKILL.md bundles plus flat <name>.md files, which is exactly the
// provider's own discovery rule at one level of depth.
function countSkills(dir) {
  if (!dir || typeof dir !== 'string' || dir.startsWith('«') || dir.startsWith('!!js')) return null
  if (!fs.existsSync(dir)) return 0
  let n = 0
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    if (e.isDirectory() && fs.existsSync(path.join(dir, e.name, 'SKILL.md'))) n++
    else if (e.isFile() && e.name.endsWith('.md')) n++
  }
  return n
}

function mcpFrom(module, entryId, config, origin) {
  return {
    server: config?.serverName ?? entryId,
    plugin: module,
    entryId,
    origin,
    transport: config?.transport ?? 'stdio',
    target: config?.command
      ? `${config.command} ${(config.args ?? []).join(' ')}`.trim()
      : (config?.url ?? null),
  }
}

function buildPreset(profile, row, defaultId, hostInherited) {
  const cfg = row.config ?? {}
  const rows = flatten(cfg.plugins)
  const tools = []
  const conditional = []
  const mcps = []
  const skillProviders = []
  const notes = []
  const seen = new Set()

  const addTool = (name, plugin, entryId, source) => {
    if (seen.has(name)) return
    seen.add(name)
    const why = CONDITIONAL_TOOLS.get(name)
    if (why) conditional.push({ name, plugin, entryId, source, reason: why })
    else tools.push({ name, plugin, entryId, source })
  }

  // Host rows reach every preset (see the note at the top of this file).
  for (const h of hostInherited) {
    for (const n of h.tools) addTool(n, h.module, h.id, 'host')
    for (const d of h.deferred ?? []) {
      conditional.push({ name: d, plugin: h.module, entryId: h.id, source: 'host', reason: h.reason })
    }
    for (const m of h.mcps ?? []) mcps.push(m)
  }

  for (const r of rows) {
    if (r.enabled === false) continue
    const dir = packageDir(profile, r.module)
    const { pkg } = splitModule(r.module)
    const isConditional = r.enabled === 'conditional'

    if (pkg === '@deepseek-ai/dsh-mcp-client') {
      mcps.push(mcpFrom(r.module, r.id, r.config, 'preset'))
      continue
    }
    if (pkg === '@deepseek-ai/dsh-skill-filesystem') {
      skillProviders.push({
        entryId: r.id,
        provider: r.config?.providerName ?? 'filesystem',
        roots: skillRootsFrom(r.config).map((x) => ({ ...x, skills: countSkills(x.dir) })),
      })
      continue
    }

    const scan = toolsOf(dir, r.module)
    if (scan.approx) notes.push(`tool list approximate: ${r.module} (subpath has no own file)`)
    if (!dir) notes.push(`unresolved module: ${r.module} (${r.id})`)
    const names = new Set(scan.names)
    // A row may rename the one tool it mounts.
    if (typeof r.config?.toolName === 'string') names.add(r.config.toolName)
    for (const n of names) {
      if (isConditional) {
        conditional.push({
          name: n,
          plugin: r.module,
          entryId: r.id,
          source: 'preset',
          reason: `row gated by !!js ${String(r.condition).slice(0, 70)}`,
        })
      } else addTool(n, r.module, r.id, 'preset')
    }
  }

  tools.sort((a, b) => a.name.localeCompare(b.name))
  conditional.sort((a, b) => a.name.localeCompare(b.name))

  // Skills total over roots that exist on disk. A project root resolves per
  // workspace and a `!!js` root is built at runtime, so those are reported as
  // uncounted rather than silently read as zero.
  const skillTotal = (() => {
    const seenDirs = new Set()
    let total = 0
    let uncounted = 0
    for (const p of skillProviders) {
      for (const r of p.roots) {
        if (r.skills === null) { uncounted++; continue }
        if (seenDirs.has(r.dir)) continue
        seenDirs.add(r.dir)
        total += r.skills
      }
    }
    return { total, uncounted }
  })()

  return {
    id: cfg.id,
    name: cfg.name ?? null,
    description: cfg.description ?? null,
    order: cfg.order ?? null,
    isDefault: cfg.id === defaultId,
    counts: {
      rows: rows.length,
      active: rows.filter((r) => r.enabled !== false).length,
      conditionalRows: rows.filter((r) => r.enabled === 'conditional').length,
      tools: tools.length,
      conditionalTools: conditional.length,
      mcpServers: mcps.filter((m) => m.origin === 'preset').length,
      hostMcpServers: mcps.filter((m) => m.origin === 'host').length,
      skillProviders: skillProviders.length,
      skills: skillTotal.total,
      skillsUncounted: skillTotal.uncounted,
    },
    tools,
    conditional,
    mcps,
    skills: skillProviders,
    rows,
    notes,
  }
}

function loadSnapshot(profile, refresh) {
  const { yml, fromCache } = dumpProfile(profile, refresh)
  const doc = yaml.load(yml, { schema: SCHEMA })
  if (!Array.isArray(doc)) throw new Error('--dump-config did not produce an entry list')

  const presetRows = doc.filter((r) => r && r.name === '@deepseek-ai/dsh-agent-preset')
  const registry = doc.find((r) => r && r.name === '@deepseek-ai/dsh-agent-preset-registry')
  const defaultId = registry?.config?.selectedDefault ?? registry?.config?.default ?? null

  // Host rows that register tools and are not switched off. The shipped
  // composition disables most of them per preset, so this list is short.
  const hostInherited = []
  for (const r of doc) {
    if (!r || !r.name || r.group === true) continue
    if (r.name === '@deepseek-ai/dsh-agent-preset') continue
    if (r.disabled === true) continue
    const dir = packageDir(profile, r.name)
    const { pkg } = splitModule(r.name)
    if (pkg === '@deepseek-ai/dsh-mcp-client') {
      hostInherited.push({ id: r.id, module: r.name, tools: [], mcps: [mcpFrom(r.name, r.id, r.config, 'host')] })
      continue
    }
    if (DEFERRED_PACKAGES.has(pkg)) {
      hostInherited.push({
        id: r.id,
        module: r.name,
        tools: [],
        deferred: toolsOf(dir, r.name).names,
        reason: DEFERRED_PACKAGES.get(pkg),
      })
      continue
    }
    const { names } = toolsOf(dir, r.name)
    if (names.length === 0) continue
    hostInherited.push({ id: r.id, module: r.name, tools: names })
  }

  const presets = presetRows
    .map((r) => buildPreset(profile, r, defaultId, hostInherited))
    .sort((a, b) => (a.order ?? Infinity) - (b.order ?? Infinity) || a.id.localeCompare(b.id))

  return {
    profile,
    defaultId,
    generatedAt: new Date().toISOString(),
    source: 'dsh --dump-config',
    fromCache,
    hostRowCount: doc.filter((r) => r && r.name !== '@deepseek-ai/dsh-agent-preset').length,
    hostInherited,
    presets,
  }
}

// ──────────────────────────────────────────────────────────────── rendering

const dim = (s) => `\x1b[2m${s}\x1b[0m`
const bold = (s) => `\x1b[1m${s}\x1b[0m`
const cyan = (s) => `\x1b[36m${s}\x1b[0m`
const yellow = (s) => `\x1b[33m${s}\x1b[0m`

function table(head, body) {
  const w = head.map((h, i) => Math.max(h.length, ...body.map((r) => r[i].length)))
  console.log(bold(head.map((c, i) => c.padEnd(w[i])).join('  ')))
  console.log(dim(w.map((x) => '─'.repeat(x)).join('  ')))
  for (const r of body) {
    console.log(cyan(r[0].padEnd(w[0])) + '  ' + r.slice(1).map((c, i) => c.padEnd(w[i + 1])).join('  '))
  }
}

function listTable(snap) {
  console.log()
  table(
    ['preset', 'order', 'rows', 'tools', 'skills', 'mcps', 'default'],
    snap.presets.map((p) => [
      p.id,
      String(p.order ?? '—'),
      `${p.counts.active}/${p.counts.rows}`,
      String(p.counts.tools),
      `${p.counts.skills}${p.counts.skillsUncounted ? `+${p.counts.skillsUncounted}?` : ''}`,
      String(p.counts.mcpServers + p.counts.hostMcpServers),
      p.isDefault ? '*' : '',
    ]),
  )
  console.log()
  console.log(dim(`profile ${cyan(snap.profile)} · ${snap.hostRowCount} host rows · default ${snap.defaultId} · ${snap.source}`))
  console.log(dim('tools = callable at session start. skills N+M? = N found on disk, M roots resolved only at runtime.'))
  console.log(dim('host rows that register tools reach every preset: ' + (snap.hostInherited.map((h) => h.id).join(', ') || 'none')))
  console.log()
}

function showPreset(snap, id) {
  const p = snap.presets.find((x) => x.id === id)
  if (!p) {
    console.error(`no such preset: ${id}\navailable: ${snap.presets.map((x) => x.id).join(', ')}`)
    process.exit(2)
  }
  console.log()
  console.log(bold(p.id) + (p.name ? `  ${p.name}` : '') + (p.isDefault ? dim('  (default)') : ''))
  if (p.description) console.log(dim(p.description))
  console.log(dim(`${p.counts.active}/${p.counts.rows} rows active · ${p.counts.tools} tools · ${p.counts.mcpServers + p.counts.hostMcpServers} MCP servers · ${p.counts.skills}${p.counts.skillsUncounted ? ` (+${p.counts.skillsUncounted} runtime roots)` : ''} skills`))

  console.log(`\n${bold('TOOLS')} ${dim(`(${p.counts.tools})`)}`)
  const byPlugin = new Map()
  for (const t of p.tools) {
    if (!byPlugin.has(t.plugin)) byPlugin.set(t.plugin, [])
    byPlugin.get(t.plugin).push(t.name)
  }
  for (const [plugin, names] of [...byPlugin].sort()) {
    const host = p.tools.find((t) => t.plugin === plugin)?.source === 'host'
    console.log(`  ${plugin}${host ? dim('  (inherited from host)') : ''}`)
    console.log(`    ${names.join(', ')}`)
  }
  if (!p.tools.length) console.log(dim('  none'))

  if (p.conditional.length) {
    console.log(`\n${bold('CONDITIONAL TOOLS')} ${dim(`(${p.conditional.length}) — registered only under a condition`)}`)
    for (const c of p.conditional) {
      console.log(`  ${yellow('?')} ${c.name.padEnd(26)} ${dim(c.reason)}`)
    }
  }

  console.log(`\n${bold('MCP SERVERS')} ${dim(`(${p.counts.mcpServers + p.counts.hostMcpServers})`)}`)
  if (!p.mcps.length) console.log(dim('  none'))
  for (const m of p.mcps) {
    console.log(`  ${m.server.padEnd(16)} ${m.transport.padEnd(16)} ${dim(String(m.target ?? '').slice(0, 60))} ${dim(`[${m.origin}]`)}`)
  }

  console.log(`\n${bold('SKILLS')}`)
  if (!p.skills.length) console.log(dim('  none — this preset mounts no skill provider'))
  for (const s of p.skills) {
    console.log(`  provider ${s.provider} ${dim(`(${s.entryId})`)}`)
    for (const r of s.roots) {
      const n = r.skills === null ? '?' : String(r.skills)
      console.log(`    ${n.padStart(3)} ${r.source.padEnd(14)} ${dim(r.dir)}`)
    }
  }

  console.log(`\n${bold('ROWS')} ${dim(`(${p.rows.length})`)}`)
  for (const r of p.rows) {
    const state = r.enabled === false ? 'off ' : r.enabled === 'conditional' ? 'cond' : 'on  '
    const mark = r.enabled === false ? dim('·') : r.enabled === 'conditional' ? yellow('◐') : '●'
    console.log(`  ${mark} ${state} ${String(r.id ?? '—').padEnd(24)} ${dim(r.module)}`)
  }
  if (p.notes.length) {
    console.log(`\n${bold('NOTES')}`)
    for (const n of p.notes) console.log(`  ! ${n}`)
  }
  console.log()
}

function matrix(snap) {
  const caps = new Map()
  const touch = (k, id) => {
    if (!caps.has(k)) caps.set(k, new Set())
    caps.get(k).add(id)
  }
  for (const p of snap.presets) {
    for (const t of p.tools) touch(t.name, p.id)
    for (const c of p.conditional) touch(`? ${c.name}`, p.id)
    for (const m of p.mcps) touch(`mcp ${m.server}`, p.id)
  }
  const ids = snap.presets.map((p) => p.id)
  console.log()
  console.log(bold('capability'.padEnd(32) + ids.map((i) => i.slice(0, 5).padStart(6)).join('')))
  console.log(dim('─'.repeat(32 + 6 * ids.length)))
  for (const [name, have] of [...caps].sort()) {
    console.log(name.padEnd(32) + ids.map((i) => (have.has(i) ? '  ●  ' : '  ·  ')).join(''))
  }
  console.log()
  console.log(dim(`columns: ${ids.join(' · ')}`))
  console.log(dim('? = conditional tool.'))
  console.log()
}

function diffPresets(snap, a, b) {
  const A = snap.presets.find((p) => p.id === a)
  const B = snap.presets.find((p) => p.id === b)
  if (!A || !B) { console.error(`unknown preset in "${a}" / "${b}"`); process.exit(2) }
  const names = (p) => new Set([...p.tools, ...p.conditional].map((t) => t.name))
  const ta = names(A)
  const tb = names(B)
  const onlyA = [...ta].filter((x) => !tb.has(x)).sort()
  const onlyB = [...tb].filter((x) => !ta.has(x)).sort()
  console.log(`\n${bold(`only in ${a}`)} ${dim(`(${onlyA.length})`)}`)
  console.log(onlyA.length ? '  ' + onlyA.join(', ') : dim('  none'))
  console.log(`\n${bold(`only in ${b}`)} ${dim(`(${onlyB.length})`)}`)
  console.log(onlyB.length ? '  ' + onlyB.join(', ') : dim('  none'))

  const ma = new Set(A.mcps.map((m) => m.server))
  const mb = new Set(B.mcps.map((m) => m.server))
  console.log(`\n${bold('MCP servers')}`)
  console.log(`  only ${a}: ${[...ma].filter((x) => !mb.has(x)).join(', ') || dim('none')}`)
  console.log(`  only ${b}: ${[...mb].filter((x) => !ma.has(x)).join(', ') || dim('none')}`)

  const ida = new Set(A.rows.map((r) => `${r.id}:${r.module}`))
  const idb = new Set(B.rows.map((r) => `${r.id}:${r.module}`))
  console.log(`\n${bold('rows')}`)
  console.log(`  only ${a}: ${[...ida].filter((x) => !idb.has(x)).sort().join(', ') || dim('none')}`)
  console.log(`  only ${b}: ${[...idb].filter((x) => !ida.has(x)).sort().join(', ') || dim('none')}`)
  console.log()
}

// ───────────────────────────────────────────────────────────────────── main

const argv = process.argv.slice(2)
let profile = 'web'
let refresh = false
const positional = []
for (let i = 0; i < argv.length; i++) {
  const a = argv[i]
  if (a === '--profile') profile = argv[++i]
  else if (a.startsWith('--profile=')) profile = a.slice('--profile='.length)
  else if (a === '--refresh') refresh = true
  else if (a === '-h' || a === '--help') { console.log(USAGE); process.exit(0) }
  else positional.push(a)
}

const cmd = positional[0] ?? 'list'
const snap = loadSnapshot(profile, refresh)

switch (cmd) {
  case 'list': listTable(snap); break
  case 'show': showPreset(snap, positional[1]); break
  case 'matrix': matrix(snap); break
  case 'diff': diffPresets(snap, positional[1], positional[2]); break
  case 'json': process.stdout.write(JSON.stringify(snap, null, 2) + '\n'); break
  default:
    console.error(`unknown command: ${cmd}\n`)
    console.log(USAGE)
    process.exit(2)
}
